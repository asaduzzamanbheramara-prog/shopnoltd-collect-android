# ShopnoltdCollect local/test environment
# Copy this file to secrets.properties and fill in values locally.
# NEVER commit secrets.properties, passwords, keystores, or private keys.

# Android release signing (local only)
RELEASE_STORE_FILE=/home/shopno/shopnoltd-signing/shopnoltd-collect-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=shopnoltdcollect
RELEASE_KEY_PASSWORD=

# Firebase / Google services
# Firebase configuration itself belongs in collect_app/google-services.json.
# Do not put Firebase Admin SDK credentials in the Android app.
FIREBASE_PROJECT_ID=shopnoltdcollect

# Optional map/service configuration
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=
ENTITIES_FILTER_PROJECT_URL=
ENTITIES_FILTER_SEARCH_PROJECT_URL=
THOUSAND_MEDIA_FILE_PROJECT_URL=
THOUSAND_MEDIA_FILE_ENTITY_LIST_PROJECT_URL=

# Shopnoltd backend used by the app/test environment
SHOPNOLTD_API_BASE_URL=https://api.shopnoltd.dpdns.org
